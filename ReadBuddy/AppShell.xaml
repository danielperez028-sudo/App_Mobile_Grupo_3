<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReadBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ReadBuddy.Views"
    Title="ReadBuddy">

    <ShellContent
        Title="Login"
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar>

        <ShellContent
            Title="Inicio"
            Route="home"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent
            Title="Historias"
            Route="stories"
            ContentTemplate="{DataTemplate views:StoriesPage}" />

        <ShellContent
            Title="Creacion"
            Route="story-form"
            ContentTemplate="{DataTemplate views:StoryFormPage}" />

    </TabBar>

</Shell>
