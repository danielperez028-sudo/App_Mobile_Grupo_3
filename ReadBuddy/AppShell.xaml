<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReadBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ReadBuddy.Views"
    Title="ReadBuddy">
    
    

    <ShellContent
        Title="Login"
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Shell.FlyoutBehavior="Disabled"
        Shell.FlyoutItemIsVisible="False"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Title="Registro Estudiante"
        Route="register-student"
        ContentTemplate="{DataTemplate views:RegisterStudentPage}"
        Shell.FlyoutBehavior="Disabled"
        Shell.FlyoutItemIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <FlyoutItem Title="Menú Estudiante" Shell.FlyoutItemIsVisible="False"
                Route="student-app">

        <ShellContent
            Title="Inicio"
            Route="home"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent
            Title="Historias"
            Route="stories"
            ContentTemplate="{DataTemplate views:StoriesPage}" />

        

    </FlyoutItem>

    <FlyoutItem Title="Panel de Control (Admin)" Shell.FlyoutItemIsVisible="False" Route="admin-panel">

        
        <ShellContent
            Title="Gestión General"
            Route="admin-home"
            Shell.FlyoutItemIsVisible="False"
            ContentTemplate="{DataTemplate views:AdminDashboardPage}"/>



    </FlyoutItem>


    <MenuItem Text=" 🚪 Cerrar sesión"
              Clicked="OnLogoutButtonClicked" />

</Shell>
