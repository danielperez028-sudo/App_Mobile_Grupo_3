<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ReadBuddy.Models"
    xmlns:vm="clr-namespace:ReadBuddy.ViewModels"
    x:Class="ReadBuddy.Views.ManageStoriesPage"
    x:DataType="vm:StoriesViewModel"
    Shell.NavBarIsVisible="False"
    Title="Administrar historias"
    BackgroundColor="{StaticResource BackgroundCream}">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="10">
            <Button
                Text="← Volver"
                HorizontalOptions="Start"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding BackCommand}" />
            <Label Text="Administrar historias" Style="{StaticResource PageTitleStyle}" />
            <Button
                Text="➕ Nueva historia"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding AddCommand}" />
            <SearchBar Text="{Binding SearchText}" Placeholder="Buscar una historia..." />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Stories}" SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30" Spacing="10">
                    <Label Text="📖" FontSize="50" HorizontalTextAlignment="Center" />
                    <Label Text="No hay historias registradas." HorizontalTextAlignment="Center" TextColor="Gray" FontSize="15" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Story">
                    <Border
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="15"
                        Margin="20,0,20,12">

                        <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="15">

                            <Border
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 15"
                                HeightRequest="60"
                                WidthRequest="60">
                                <Label Text="{Binding Cover}" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                                <Label Text="{Binding Level, StringFormat='⭐ {0}'}" FontSize="13" TextColor="{StaticResource SecondaryOrange}" />
                                <Label Text="{Binding StatusLabel}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                <Button
                                    Text="✏️" FontSize="22" Padding="0"
                                    WidthRequest="48" HeightRequest="48"
                                    BackgroundColor="Transparent"
                                    x:DataType="{x:Null}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoriesViewModel}}, Path=EditCommand}"
                                    CommandParameter="{Binding .}" />
                                <Button
                                    Text="🗑️" FontSize="22" Padding="0"
                                    WidthRequest="48" HeightRequest="48"
                                    BackgroundColor="Transparent"
                                    x:DataType="{x:Null}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoriesViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>