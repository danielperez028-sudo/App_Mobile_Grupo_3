<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReadBuddy.Views.RegisterStudentPage"
             Title="Registro Estudiante"
             BackgroundColor="{StaticResource BackgroundCream}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            
            <Border BackgroundColor="{StaticResource PrimaryBlue}"
                    StrokeThickness="0"
                    Padding="50,40,30,45">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="🚀" FontSize="60" HorizontalTextAlignment="Center" />
                    <Label Text="Crear Perfil" TextColor="White" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="¡Únete a la aventura de leer!" TextColor="White" FontSize="15" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            
            <Border BackgroundColor="{StaticResource CardWhite}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Margin="25,-25,25,25"
                    Padding="25">

                <VerticalStackLayout Spacing="12">

                    
                    <Label Text="Nombre del Estudiante *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                    <Entry x:Name="NameEntry" Placeholder="¿Cómo te llamas?" HeightRequest="52" BackgroundColor="#F7F7F7" />

                    
                    <Label Text="Edad *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" Margin="0,5,0,0" />
                    <Entry x:Name="AgeEntry" Placeholder="¿Cuántos años tienes?" Keyboard="Numeric" HeightRequest="52" BackgroundColor="#F7F7F7" />

                    
                    <Label Text="Elige tu Avatar (Emoji) " FontAttributes="Bold" TextColor="{StaticResource TextDark}" Margin="0,5,0,0" />
                    <Entry x:Name="AvatarEntry" Placeholder="Ej: 🦊, 🦁, 🤖, 🦄" HeightRequest="52" BackgroundColor="#F7F7F7" />

                    
                    <Label Text="Elige tu Nombre de Usuario *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" Margin="0,5,0,0" />
                    <Entry x:Name="UserNameEntry" Placeholder="Ej: alex_lector" HeightRequest="52" BackgroundColor="#F7F7F7" />
                    
                    
                    <Label Text="Elige una Contraseña *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" Margin="0,5,0,0" />
                    <Entry x:Name="PasswordEntry" Placeholder="Crea una contraseña segura" IsPassword="True" HeightRequest="52" BackgroundColor="#F7F7F7" />

                    

                  
                    <Button Text="Guardar mi Perfil"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,20,0,0"
                            Clicked="OnGuardarPerfilClicked" />

                    <Button Text="Volver al Login"
                            TextColor="{StaticResource PrimaryBlue}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource PrimaryBlue}"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="45"
                            Margin="0,5,0,0"
                            Clicked="OnBackToLoginClicked" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
