<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ReadBuddy.Models"
             xmlns:vm="clr-namespace:ReadBuddy.ViewModels"
             x:Class="ReadBuddy.Views.ManageQuestionsPage"
             x:DataType="vm:ManageQuestionsViewModel"
             Shell.NavBarIsVisible="False"
             Title="Administrar preguntas"
             BackgroundColor="{StaticResource BackgroundCream}">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="10">
            <Button Text="← Volver" HorizontalOptions="Start"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding BackCommand}" />
            <Label Text="Administrar preguntas" Style="{StaticResource PageTitleStyle}" />
            <Button Text="➕ Nueva pregunta"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AddCommand}" />
            <SearchBar Text="{Binding SearchText}" Placeholder="Buscar por pregunta o historia..." />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Questions}" SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30" Spacing="10">
                    <Label Text="❓" FontSize="50" HorizontalTextAlignment="Center" />
                    <Label Text="No hay preguntas registradas." HorizontalTextAlignment="Center" TextColor="Gray" FontSize="15" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Question">
                    <Border BackgroundColor="White" StrokeThickness="0"
                            StrokeShape="RoundRectangle 18" Padding="15" Margin="20,0,20,12">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding StoryTitle, StringFormat='📖 {0}'}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Text}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                                <Label Text="{Binding Skill}" FontSize="12" TextColor="{StaticResource SecondaryOrange}" />
                                <Label Text="{Binding CorrectAnswer, StringFormat='✅ {0}'}" FontSize="12" TextColor="{StaticResource TextDark}" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Button Text="✏️" FontSize="22" Padding="0"
                                        WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent"
                                        x:DataType="{x:Null}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageQuestionsViewModel}}, Path=EditCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="🗑️" FontSize="22" Padding="0"
                                        WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent"
                                        x:DataType="{x:Null}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageQuestionsViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>