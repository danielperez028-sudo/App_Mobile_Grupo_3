<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ReadBuddy.Views.StoriesPage"
    Title="Stories"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundCream}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="20,20,20,10"
            Spacing="5">

            <Label
                Text="Historias 📚"
                Style="{StaticResource PageTitleStyle}" />

            <Label
                Text="Escoge una historia para practicar."
                Style="{StaticResource BodyTextStyle}" />

            <SearchBar
                Placeholder="Buscar una historia..."
                Margin="0,10,0,0" />

        </VerticalStackLayout>


        <!-- Filters -->

        <HorizontalStackLayout
            Grid.Row="1"
            Padding="20,5"
            Spacing="8">

            <Button
                Text="Todas"
                BackgroundColor="{StaticResource SecondaryOrange}"
                TextColor="White"
                CornerRadius="18"
                HeightRequest="40" />

            <Button
                Text="Facil"
                BackgroundColor="White"
                TextColor="{StaticResource TextDark}"
                CornerRadius="18"
                HeightRequest="40" />

            <Button
                Text="Medio"
                BackgroundColor="White"
                TextColor="{StaticResource TextDark}"
                CornerRadius="18"
                HeightRequest="40" />

            <Button
                Text="Dificil"
                BackgroundColor="White"
                TextColor="{StaticResource TextDark}"
                CornerRadius="18"
                HeightRequest="40" />

        </HorizontalStackLayout>


        <!-- Story cards -->

        <ScrollView
            Grid.Row="2">

            <VerticalStackLayout
                Padding="20,10,20,100"
                Spacing="12">


                <!-- Story 1 -->

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="15">

                    <Grid
                        ColumnDefinitions="70,*,Auto"
                        ColumnSpacing="20">

                        <Border
                            BackgroundColor="{StaticResource PrimaryBlue}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            HeightRequest="70"
                            WidthRequest="70">

                            <Label
                                Text="🐶"
                                FontSize="38"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="5">

                            <Label
                                Text="El perro aventurero"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextDark}" />

                            <Label
                                Text="⭐ Facil"
                                FontSize="14"
                                TextColor="{StaticResource SecondaryOrange}" />

                            <Label
                                Text="Idea principal"
                                FontSize="13"
                                TextColor="{StaticResource TextDark}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="✓"
                            TextColor="{StaticResource SuccessGreen}"
                            FontSize="26"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>


                <!-- Story 2 -->

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="15">

                    <Grid
                        ColumnDefinitions="70,*,Auto"
                        ColumnSpacing="15">

                        <Border
                            BackgroundColor="{StaticResource SecondaryOrange}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            HeightRequest="70"
                            WidthRequest="70">

                            <Label
                                Text="🔑"
                                FontSize="38"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="5">

                            <Label
                                Text="La llave misteriosa"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextDark}" />

                            <Label
                                Text="⭐⭐ Medio"
                                FontSize="14"
                                TextColor="{StaticResource SecondaryOrange}" />

                            <Label
                                Text=" Inferencias"
                                FontSize="13"
                                TextColor="{StaticResource TextDark}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="Nueva"
                            TextColor="{StaticResource SecondaryOrange}"
                            FontSize="12"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>


                <!-- Story 3 -->

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="15">

                    <Grid
                        ColumnDefinitions="70,*,Auto"
                        ColumnSpacing="15">

                        <Border
                            BackgroundColor="{StaticResource SuccessGreen}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            HeightRequest="70"
                            WidthRequest="70">

                            <Label
                                Text="🌲"
                                FontSize="38"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="5">

                            <Label
                                Text="La aventura en el bosque"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextDark}" />

                            <Label
                                Text="⭐⭐⭐ Dificil"
                                FontSize="14"
                                TextColor="{StaticResource SecondaryOrange}" />

                            <Label
                                Text=" Vocabulario"
                                FontSize="13"
                                TextColor="{StaticResource TextDark}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="Nueva"
                            TextColor="{StaticResource SecondaryOrange}"
                            FontSize="12"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>


                <!--add button -->

                <Button
                    Text="+  Añadir nueva historia"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,10,0,0" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>