<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ReadBuddy.Models"
    x:Class="ReadBuddy.Views.StoriesPage"
    Shell.NavBarIsVisible="False"
    Title="Historias"
    BackgroundColor="{StaticResource BackgroundCream}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="20,20,20,10"
            Spacing="5">

            <Label
                Text="Historias 📚"
                Style="{StaticResource PageTitleStyle}" />

            <Label
                Text="Escoge una historia para practicar."
                Style="{StaticResource BodyTextStyle}" />

            <SearchBar
                x:Name="StorySearchBar"
                Placeholder="Buscar una historia..."
                Margin="0,10,0,0"
                TextChanged="OnSearchBarTextChanged" />

        </VerticalStackLayout>


        <!-- Filters -->

        <HorizontalStackLayout
            Grid.Row="1"
            Padding="20,5"
            Spacing="8">

            <Button
                Text="Todas"
                x:Name="BtnAll"
                BackgroundColor="{StaticResource SecondaryOrange}"
                TextColor="White"
                CornerRadius="18"
                HeightRequest="40"
                Clicked="OnFilterButtonClicked"/>

            <Button
                Text="Facil"
                x:Name="BtnEasy"
                BackgroundColor="White"
                TextColor="{StaticResource TextDark}"
                CornerRadius="18"
                HeightRequest="40"
                Clicked="OnFilterButtonClicked" />

            <Button
                Text="Medio"
                x:Name="BtnMedium"
                BackgroundColor="White"
                TextColor="{StaticResource TextDark}"
                CornerRadius="18"
                HeightRequest="40"
                Clicked="OnFilterButtonClicked"/>

            <Button
                Text="Dificil"
                x:Name="BtnHard"
                BackgroundColor="White"
                TextColor="{StaticResource TextDark}"
                CornerRadius="18"
                HeightRequest="40"
                Clicked="OnFilterButtonClicked" />

        </HorizontalStackLayout>


        <!-- Dynamic Catalog Collection -->
        <CollectionView
            Grid.Row="2"
            x:Name="StoriesCollectionView"
            SelectionMode="Single"                     
            SelectionChanged="OnStorySelectionChanged"
            Margin="0,10,0,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="30">
                    <Label Text="📖" FontSize="50" HorizontalTextAlignment="Center"/>
                    <Label Text="No hay historias disponibles en este nivel." HorizontalTextAlignment="Center" TextColor="Gray" FontSize="15"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Story">
                    <Border
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="15"
                        Margin="20,0,20,12">

                        <Grid
                            ColumnDefinitions="70,*,Auto"
                            ColumnSpacing="20">

                            <!-- Cover Image Container -->
                            <Border
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 15"
                                HeightRequest="70"
                                WidthRequest="70">

                                <Label
                                    Text="{Binding Cover}"
                                    FontSize="38"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <!-- Info Content -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="5">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextDark}" />

                                <Label
                                    Text="{Binding Level, StringFormat='⭐ {0}'}"
                                    FontSize="14"
                                    TextColor="{StaticResource SecondaryOrange}" />

                                <Label
                                    Text="{Binding Skill}"
                                    FontSize="13"
                                    TextColor="{StaticResource TextDark}" />
                            </VerticalStackLayout>

                            <!-- Badge  Right side -->
                            <Label
                                Grid.Column="2"
                                Text="Nueva"
                                TextColor="{StaticResource SecondaryOrange}"
                                FontSize="12"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>