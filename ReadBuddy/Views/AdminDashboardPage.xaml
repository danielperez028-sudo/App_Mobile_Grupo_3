<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ReadBuddy.Models"
             xmlns:vm="clr-namespace:ReadBuddy.ViewModels"
             x:Class="ReadBuddy.Views.AdminDashboardPage"
             x:DataType="vm:AdminDashboardViewModel"
             Title="Panel de Administración"
             BackgroundColor="{StaticResource BackgroundCream}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Header banner -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource PrimaryBlue}"
                StrokeThickness="0"
                Padding="25,35,25,25">

            <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="15" VerticalOptions="Center">

                <ImageButton Grid.Column="0"
                             Source="menu_icon.png"
                             HeightRequest="35"
                             WidthRequest="35"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center"
                             Command="{Binding OpenMenuCommand}" />

                <Label Grid.Column="1" Text="⚙️" FontSize="40" VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                    <Label Text="Panel de Control" TextColor="White" FontSize="26" FontAttributes="Bold" />
                    <Label Text="Gestión global de ReadBuddy" TextColor="White" FontSize="14" Opacity="0.8" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource CardWhite}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 15"
                Margin="25,20,25,10"
                Padding="20">
            <VerticalStackLayout Spacing="10">

                <Label Text="Añadir Nuevo Contenido" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource TextDark}" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="+ Historia" Command="{Binding AddStoryCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="45" FontSize="13" />
                    <Button Grid.Column="1" Text="+ Pregunta" Command="{Binding AddQuestionCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="45" FontSize="13" />
                    <Button Grid.Column="2" Text="+ Palabra" Command="{Binding AddVocabularyCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="45" FontSize="13" />
                </Grid>

                <Label Text="Administrar" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource TextDark}" Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="📚 Historias" Command="{Binding ManageStoriesCommand}" Style="{StaticResource SecondaryButtonStyle}" HeightRequest="45" FontSize="13" />
                    <Button Grid.Column="1" Text="❓ Preguntas" Command="{Binding ManageQuestionsCommand}" Style="{StaticResource SecondaryButtonStyle}" HeightRequest="45" FontSize="13" />
                    <Button Grid.Column="2" Text="🧠 Palabras" Command="{Binding ManageVocabularyCommand}" Style="{StaticResource SecondaryButtonStyle}" HeightRequest="45" FontSize="13" />
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- Students (read only) -->
        <Grid Grid.Row="2" RowDefinitions="Auto, *" Margin="25,10,25,25">
            <Label Grid.Row="0" Text="Alumnos Registrados" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource TextDark}" Margin="0,5,0,10" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Students}" SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="30">
                        <Label Text="👥" FontSize="50" HorizontalTextAlignment="Center" />
                        <Label Text="No hay estudiantes registrados todavía." HorizontalTextAlignment="Center" TextColor="Gray" FontSize="15" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Student">
                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Margin="0,0,0,10"
                                Padding="15">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15" VerticalOptions="Center">

                                <Label Grid.Column="0" Text="{Binding Avatar}" FontSize="32" VerticalOptions="Center" HorizontalTextAlignment="Center" />

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextDark}" />
                                    <Label Text="{Binding UserName, StringFormat='@{0}'}" FontSize="13" TextColor="Gray" />
                                </VerticalStackLayout>

                                <Border Grid.Column="2" BackgroundColor="#E3F2FD" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,5">
                                    <Label Text="{Binding Age, StringFormat='{0} años'}" TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold" FontSize="12" />
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>