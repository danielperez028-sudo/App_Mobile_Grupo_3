<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ReadBuddy.Models"
             xmlns:vm="clr-namespace:ReadBuddy.ViewModels"
             x:Class="ReadBuddy.Views.VocabularyPage"
             x:DataType="vm:VocabularyViewModel"
             Title="Vocabulario"
             BackgroundColor="{StaticResource BackgroundCream}"
             Shell.NavBarIsVisible="true">

    <Grid RowDefinitions="Auto, *">

        <!-- Header with search -->
        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,10" Spacing="5">

            <Label Text="Mi Diccionario 🧠" Style="{StaticResource PageTitleStyle}" />

            <Label Text="Aprende el significado de palabras nuevas aquí." Style="{StaticResource BodyTextStyle}" />

            <SearchBar Text="{Binding SearchText}"
                       Placeholder="Buscar una palabra..."
                       Margin="0,10,0,0" />
        </VerticalStackLayout>

        <!-- Words -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Words}"
                        SelectionMode="None"
                        Margin="0,10,0,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="30">
                    <Label Text="🔍" FontSize="50" HorizontalTextAlignment="Center" />
                    <Label Text="No encontramos esa palabra en el diccionario." HorizontalTextAlignment="Center" TextColor="Gray" FontSize="15" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VocabularyWord">
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="20"
                            Margin="20,0,20,12">

                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding Term}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextDark}" />

                                <Border Grid.Column="1"
                                        BackgroundColor="#E8F5E9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,4">
                                    <Label Text="✨ Nueva"
                                           TextColor="{StaticResource SuccessGreen}"
                                           FontAttributes="Bold"
                                           FontSize="11" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding Definition}"
                                   FontSize="15"
                                   TextColor="{StaticResource TextDark}"
                                   LineHeight="1.2" />

                            <!-- Example section, hidden when the word has no example -->
                            <VerticalStackLayout IsVisible="{Binding HasExample}" Spacing="8">
                                <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,5,0,0" />
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="🗣️ Ejemplo:"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="{StaticResource PrimaryBlue}" />
                                    <Label Text="{Binding Example}"
                                           FontAttributes="Italic"
                                           FontSize="13"
                                           TextColor="Gray" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>