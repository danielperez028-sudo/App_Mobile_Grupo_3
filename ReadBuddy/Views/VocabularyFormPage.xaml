<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReadBuddy.Views.VocabularyFormPage"
             Title="Nueva Palabra"
             BackgroundColor="{StaticResource BackgroundCream}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Nueva Palabra de Vocabulario" Style="{StaticResource PageTitleStyle}" />

            <!-- Word Input -->
            <Label Text="Palabra *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
            <Entry x:Name="WordEntry" Placeholder="Ej: Efímero, Resiliencia..." HeightRequest="52" BackgroundColor="White" />

            <!-- Definition Input -->
            <Label Text="Definición Simple *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" Margin="0,5,0,0" />
            <Editor x:Name="DefinitionEditor" Placeholder="Explica el significado de forma sencilla para un niño..." HeightRequest="120" BackgroundColor="White" AutoSize="TextChanges" />

            <!-- Usage Example Input (Optional) -->
            <Label Text="Oración de Ejemplo (Opcional)" FontAttributes="Bold" TextColor="{StaticResource TextDark}" Margin="0,5,0,0" />
            <Entry x:Name="ExampleEntry" Placeholder="Ej: La belleza del arcoíris es efímera." HeightRequest="52" BackgroundColor="White" />

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="12" Margin="0,20,0,20">
                <Button Text="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnCancelButtonClicked" />
                <Button Grid.Column="1" Text="Guardar Palabra" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveButtonClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
