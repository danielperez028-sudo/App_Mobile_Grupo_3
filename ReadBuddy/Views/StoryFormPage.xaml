<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ReadBuddy.ViewModels"
    x:Class="ReadBuddy.Views.StoryFormPage"
    x:DataType="vm:StoryFormViewModel"
    Title="Story"
    BackgroundColor="{StaticResource BackgroundCream}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{Binding FormTitle}" Style="{StaticResource PageTitleStyle}" />

            <!-- Cover -->
            <Border
                BackgroundColor="White"
                Stroke="#D9D9D9"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 18"
                HeightRequest="150"
                Padding="20">

                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="Elegir portada *" TextColor="{StaticResource TextDark}" FontAttributes="Bold" />
                    <Entry
                        Text="{Binding Cover}"
                        Placeholder="Ej: 🦊, 🐉, 🚀, 🪐"
                        HeightRequest="52"
                        BackgroundColor="White" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding CoverError}" IsVisible="{Binding HasCoverError}" Style="{StaticResource ErrorTextStyle}" />

            <!-- Title -->
            <Label Text="Titulo *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
            <Entry
                Text="{Binding Title}"
                Placeholder="El zorro y la luna"
                HeightRequest="52"
                BackgroundColor="White" />
            <Label Text="{Binding TitleError}" IsVisible="{Binding HasTitleError}" Style="{StaticResource ErrorTextStyle}" />

            <!-- Level and Skill -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Nivel *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                    <Picker
                        Title="Selecciona Nivel"
                        ItemsSource="{Binding Levels}"
                        SelectedItem="{Binding Level}"
                        BackgroundColor="White" />
                    <Label Text="{Binding LevelError}" IsVisible="{Binding HasLevelError}" Style="{StaticResource ErrorTextStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Habilidad *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                    <Picker
                        Title="Selecciona habilidad"
                        ItemsSource="{Binding Skills}"
                        SelectedItem="{Binding Skill}"
                        BackgroundColor="White" />
                    <Label Text="{Binding SkillError}" IsVisible="{Binding HasSkillError}" Style="{StaticResource ErrorTextStyle}" />
                </VerticalStackLayout>

            </Grid>

            <!-- Category -->
            <Label Text="Categoria *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" Margin="0,5,0,0" />
            <Entry
                Text="{Binding Category}"
                Placeholder="Animales, aventura..."
                HeightRequest="52"
                BackgroundColor="White" />
            <Label Text="{Binding CategoryError}" IsVisible="{Binding HasCategoryError}" Style="{StaticResource ErrorTextStyle}" />

            <!-- Content -->
            <Label Text="Contenido *" FontAttributes="Bold" TextColor="{StaticResource TextDark}" Margin="0,5,0,0" />
            <Editor
                Text="{Binding Content}"
                Placeholder="Escribe el contenido de la historia..."
                HeightRequest="220"
                BackgroundColor="White"
                AutoSize="TextChanges" />
            <Label Text="{Binding ContentError}" IsVisible="{Binding HasContentError}" Style="{StaticResource ErrorTextStyle}" />

            <!-- Active -->
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="15" Margin="0,5">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Historia activa" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextDark}" />
                        <Label Text="Los usuarios la pueden ver." FontSize="13" TextColor="{StaticResource TextDark}" />
                    </VerticalStackLayout>
                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsActive}"
                        OnColor="{StaticResource SuccessGreen}" />
                </Grid>
            </Border>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="12" Margin="0,10,0,20">
                <Button
                    Text="Cancelar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}" />
                <Button
                    Grid.Column="1"
                    Text="{Binding SaveButtonText}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>